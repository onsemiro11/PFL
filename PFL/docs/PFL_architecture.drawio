  <diagram id="pfl-train" name="3. Training">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Training loop (train.py)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="350" height="40" as="geometry" />
        </mxCell>

        <!-- Setup -->
        <mxCell id="s0" value="1. Fit residual stats&#xa;fit_stats() once&#xa;res_mean, res_std" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Batch from&#xa;highwayTrajDataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="encode(*) → c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Flow loss detail -->
        <mxCell id="flow_box" value="" style="rounded=1;fillColor=#fff8e1;strokeColor=#f0a30a;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ft" value="flow_loss (OT-CFM / Rectified Flow)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#b35900;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="x₁ = normalize(fut, hist)&#xa;= (Y − y_cv − μ) / σ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="125" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="x₀ ~ N(0,I)&#xa;t ~ U(0,1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="125" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="x_t = (1−t) x₀ + t x₁&#xa;u = x₁ − x₀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="200" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="v̂ = v_θ(x_t, t, c)&#xa;L_FM = ‖(v̂ − u) ⊙ m‖²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="VectorField: TimeEmbed(t) ⊕ ctx → CondEncoder&#xa;→ 1D U-Net ResBlocks (AdaLN scale-shift)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;" vertex="1" parent="1">
          <mxGeometry x="470" y="280" width="450" height="55" as="geometry" />
        </mxCell>

        <!-- Aux -->
        <mxCell id="aux" value="maneuver_loss&#xa;CE(op_lat(c), lat)&#xa;+ CE(op_lon(c), lon)&#xa;λ = aux_weight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="loss" value="L = L_FM + λ L_man&#xa;backward + clip + Adam&#xa;EMA update (decay≈0.999)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="200" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Val -->
        <mxCell id="val" value="Periodic validate (EMA + raw)&#xa;sample K draws → RMSE, spread, calib&#xa;target calib = K/(K+1) ≈ 0.86" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;" vertex="1" parent="1">
          <mxGeometry x="1020" y="320" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ckpt" value="Save EMA ckpt&#xa;*.tar / latest.pt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="1020" y="430" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="b1" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" edge="1" parent="1" source="s2" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" edge="1" parent="1" source="s2" target="aux" style="dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b4" edge="1" parent="1" source="f1" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b5" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b6" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b7" edge="1" parent="1" source="f4" target="loss" style="strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b8" edge="1" parent="1" source="aux" target="loss" style="strokeWidth=2;strokeColor=#d6b656;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b9" edge="1" parent="1" source="f4" target="f5" style="dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b10" edge="1" parent="1" source="loss" target="val" style="dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b11" edge="1" parent="1" source="val" target="ckpt" style="dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b12" edge="1" parent="1" source="s0" target="f1" style="dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="pfl-infer" name="4. Inference">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Inference / Evaluation (evaluate.py)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="420" height="40" as="geometry" />
        </mxCell>

        <mxCell id="i0" value="Load EMA ckpt&#xa;PFLNet.eval()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="encode(*) → c&#xa;(same as train)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="100" width="150" height="55" as="geometry" />
        </mxCell>

        <!-- ODE -->
        <mxCell id="ode_box" value="" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;opacity=45;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="560" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ot" value="sample(): Euler ODE · NFE = sample_steps (default 10)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="480" height="25" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="x₀ ~ N(0,I)&#xa;[B, T_out, 2]&#xa;residual space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="for k = 0..NFE−1:&#xa;t = k/NFE&#xa;x ← x + Δt · v_θ(x,t,c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="120" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="Repeat K times&#xa;(independent noise)&#xa;→ [K, B, T, 2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="110" height="70" as="geometry" />
        </mxCell>

        <mxCell id="o4" value="denormalize&#xa;Y = x · σ + μ + y_cv&#xa;(absolute feet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nfe_note" value="NFE = # vector-field evaluations&#xa;(Euler steps). Too few → under-transported variance." style="text;html=1;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- Metrics -->
        <mxCell id="m1" value="mean_prediction&#xa;Ȳ = mean over mean_k&#xa;≈ E[Y|c]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="400" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="pick_best (oracle)&#xa;argmin endpoint err&#xa;over best_of_n" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="400" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="RMSE / ADE / FDE&#xa;(comparable to EPN μ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="510" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="minADE / minFDE&#xa;(distributional quality)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="510" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="diag" value="diagnose.py&#xa;NFE sweep {2,5,10,20,50}&#xa;+ spread / calib&#xa;(collapse check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;" vertex="1" parent="1">
          <mxGeometry x="920" y="430" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="c1" edge="1" parent="1" source="i0" target="i1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" edge="1" parent="1" source="i1" target="o1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" edge="1" parent="1" source="o2" target="o4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" edge="1" parent="1" source="o4" target="m1" style="strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" edge="1" parent="1" source="o4" target="m2" style="strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c8" edge="1" parent="1" source="m1" target="m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c9" edge="1" parent="1" source="m2" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c10" edge="1" parent="1" source="o4" target="diag" style="dashed=1;strokeColor=#c2185b;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
